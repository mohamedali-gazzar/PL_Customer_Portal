# Powerline Customer Project Portal — environment.
# Copy to .env.local for development. Never commit a filled-in copy.

# ── Data provider ───────────────────────────────────────────────────
# Leave unset. The default, "bundled", serves the committed snapshot at
# content/portal-snapshot.json and needs no configuration anywhere.
#
# bundled  — the committed snapshot (default; what deployments use)
# xlsx     — read data/backlog.xlsx on every start, for working on the derivation
# snapshot — fetch a derived snapshot over HTTPS, if you would rather not commit it
# erpnext  — read the live ERP
# PORTAL_DATA_PROVIDER=

# For "xlsx". The raw export is gitignored, so this only works locally.
EXCEL_BACKLOG_PATH=data/backlog.xlsx

# For "snapshot".
PORTAL_SNAPSHOT_URL=

# ── Session ─────────────────────────────────────────────────────────
# Signs the session cookie, which is what stops a customer editing it to name
# another company. Production requires at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORTAL_SESSION_SECRET=
PORTAL_SESSION_TTL_SECONDS=43200

# ── Sign-in ─────────────────────────────────────────────────────────
# On by default, because the customer picker is currently the only way into the
# portal: the data carries no contact records, so there is no credential to
# check. It also drives the statistics on the sign-in screen, which are visible
# to anyone holding the URL — use the host's access protection to control that.
#
# Set to 0 once logins are provisioned from ERPNext contacts.
# PORTAL_DEMO_MODE=1

# Domain accepted for staff sign-in to the PM console.
PORTAL_STAFF_EMAIL_DOMAIN=powerline.com.eg

# ── Cache ───────────────────────────────────────────────────────────
# memory  — in-process (development, single instance)
# upstash — Upstash Redis REST (production; §3 of the brief)
PORTAL_CACHE_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How long a derived snapshot is served before it is recomputed, and how long it
# may still be served while a refresh runs. Keeps portal traffic off the ERP.
PORTAL_SNAPSHOT_FRESH_SECONDS=300
PORTAL_SNAPSHOT_STALE_SECONDS=1800

# ── ERPNext ─────────────────────────────────────────────────────────
# Required only when PORTAL_DATA_PROVIDER=erpnext.
# Use the dedicated read-only service user from brief §7.2
# (portal-api@powerline.com.eg) — never an administrator token.
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_TIMEOUT_MS=15000
