# Powerline Customer Project Portal — environment.
# Copy to .env.local for development. Never commit a filled-in copy.

# ── Data provider ───────────────────────────────────────────────────
# xlsx     — derive from the PM Phase Cycle Times export on local disk
# snapshot — fetch an already-derived snapshot over HTTPS  ← use this when hosted
# erpnext  — read the live ERP
PORTAL_DATA_PROVIDER=xlsx

# For "xlsx". The export lives under data/, which is gitignored — so it is NOT in
# the repository and NOT in any deployment built from it. This provider only works
# where the file is genuinely on disk, which means locally.
EXCEL_BACKLOG_PATH=data/backlog.xlsx

# For "snapshot". Produce the file with:
#     npm run build:snapshot                 → real data
#     npm run build:snapshot -- --anonymise  → synthetic names, real dates/values
# then upload it somewhere the deployment can read (Vercel Blob, S3, …) and put
# that URL here. Refreshing after a new export is re-run + re-upload, no deploy.
PORTAL_SNAPSHOT_URL=

# ── Session ─────────────────────────────────────────────────────────
# Signs the session cookie, which is what stops a customer editing it to name
# another company. Production requires at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORTAL_SESSION_SECRET=
PORTAL_SESSION_TTL_SECONDS=43200

# ── Demo mode ───────────────────────────────────────────────────────
# The prototype's sign-in screen shows the company's total backlog and lists
# every customer with their open value, so the demo can be walked through
# without credentials. Both are commercially sensitive and are shown to an
# UNAUTHENTICATED visitor, so this must be 0 before the portal faces the
# internet. The app refuses to boot with it on in production unless
# PORTAL_ALLOW_DEMO_IN_PRODUCTION=1 is also set, for internal staging.
PORTAL_DEMO_MODE=1
# PORTAL_ALLOW_DEMO_IN_PRODUCTION=0

# Domain accepted for staff sign-in to the PM console.
PORTAL_STAFF_EMAIL_DOMAIN=powerline.com.eg

# ── Cache ───────────────────────────────────────────────────────────
# memory  — in-process (development, single instance)
# upstash — Upstash Redis REST (production; §3 of the brief)
PORTAL_CACHE_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How long a derived snapshot is served before it is recomputed, and how long it
# may still be served while a refresh runs. Keeps portal traffic off the ERP.
PORTAL_SNAPSHOT_FRESH_SECONDS=300
PORTAL_SNAPSHOT_STALE_SECONDS=1800

# ── ERPNext ─────────────────────────────────────────────────────────
# Required only when PORTAL_DATA_PROVIDER=erpnext.
# Use the dedicated read-only service user from brief §7.2
# (portal-api@powerline.com.eg) — never an administrator token.
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_TIMEOUT_MS=15000
