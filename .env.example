# ── Data provider ───────────────────────────────────────────────────
# excel   — temporary Excel backlog export (development)
# erpnext — production ERPNext API provider (not implemented yet, M6)
# fixture — synthetic data, used by the test suite
PORTAL_DATA_PROVIDER=excel

# Absolute or project-relative path to the backlog export.
# The file itself must live under data/ and is gitignored.
EXCEL_BACKLOG_PATH=data/backlog.xlsx

# ── Cache ───────────────────────────────────────────────────────────
# memory  — in-process (development, tests)
# upstash — Upstash Redis REST (production)
PORTAL_CACHE_DRIVER=memory

# Required only when PORTAL_CACHE_DRIVER=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Read-model freshness. After freshMs the entry is served stale while it
# revalidates in the background; after staleMs it is gone.
PORTAL_CACHE_FRESH_MS=90000
PORTAL_CACHE_STALE_MS=900000

# Set to 1 ONLY for a non-customer-facing staging deployment. It permits a production
# build to run on the temporary Excel provider and its preview sign-in, and logs a
# warning on every boot. Never set this where real customers can reach the portal.
PORTAL_PREVIEW_MODE=

# ── Dev session (M3 only — real auth arrives in M5) ─────────────────
# Secret used to sign the dev session cookie. Any non-empty value works
# locally. The dev session resolver refuses to run when NODE_ENV=production.
DEV_SESSION_SECRET=change-me-locally

# ── ERPNext (M6 — not read by any code yet) ─────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_WEBHOOK_SECRET=
